---
import ProfessionalPhotos from './ProfessionalPhotos.astro';
import WorkItem from './WorkItem.astro';
import PortfolioLightbox from './PortfolioLightbox.astro';
import portfolioImages from '../data/portfolio-images.json';
const { professional, workItems } = portfolioImages;
---
<ProfessionalPhotos featured={professional.featured} supporting={professional.supporting} />
{workItems.length > 0 && <section class="work-photo-system" aria-labelledby="workflow-title"><div class="shell"><header class="process-heading"><div><p class="eyebrow">From reference to real garment</p><h2 id="workflow-title">One workflow.<br /><em>Multiple sources of evidence.</em></h2></div><p>I connect reference understanding, Gerber 2D pattern development, CLO 3D evaluation and physical sample review. Each available view contributes different information to the garment-development process.</p></header><div class="garment-case-list">{workItems.map((item) => <WorkItem item={item} />)}</div><p class="confidentiality-note"><span aria-hidden="true">✦</span> Public-safe studies only. Buyer identifiers, measurements, internal comments and proprietary details are excluded or redacted.</p></div></section>}
<PortfolioLightbox />
