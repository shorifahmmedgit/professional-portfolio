---
import { orderedProjectImages, visibleStages } from '../lib/workflow.js';
interface ImageAsset { src: string; width: number; height: number; alt: string; caption?: string; }
type StageKey = 'inspiration' | 'twoD' | 'clo3D' | 'physicalSample';
interface WorkItemData { id: string; title: string; category: string; description: string; stages: Record<StageKey, ImageAsset[]>; }
interface Props { item: WorkItemData; }
const { item } = Astro.props;
const stages = visibleStages(item.stages) as [StageKey, ImageAsset[]][];
const images = orderedProjectImages(item.stages) as (ImageAsset & { stage: StageKey; stageLabel: string; stageIndex: number })[];
const labels: Record<StageKey, string> = { inspiration: 'Inspiration', twoD: '2D Pattern', clo3D: 'CLO 3D', physicalSample: 'Physical Sample' };
const workflowLabel = stages.map(([key]) => labels[key]).join(' → ');
---
<article class="garment-case" id={item.id}>
  <header class="garment-case-head">
    <h3>{item.title}</h3>
    <p class="project-workflow">{workflowLabel}</p>
  </header>
  <div class="project-gallery" role="region" aria-label={`${item.title} development images`} tabindex="0">
    {images.map((image, index) => (
      <figure class="project-image-card">
        <button type="button" class="media-trigger" aria-label={`Enlarge image: ${image.alt}`} data-lightbox-group={item.id} data-lightbox-index={index} data-lightbox-src={image.src} data-lightbox-alt={image.alt} data-lightbox-stage={`${image.stageLabel} · View ${image.stageIndex + 1}`}>
          <span class="project-image-viewport"><img src={image.src} width={image.width} height={image.height} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></span>
          <span class="project-image-caption"><strong>{image.stageLabel}</strong><small>View {image.stageIndex + 1}</small></span>
        </button>
      </figure>
    ))}
  </div>
</article>
