---
import ImageGallery from './ImageGallery.astro';
interface ImageAsset { src: string; width: number; height: number; alt: string; caption?: string; }
interface Props { featured: ImageAsset | null; supporting: ImageAsset[]; }
const { featured, supporting } = Astro.props;
const images = featured ? [featured, ...supporting] : [];
---
{images.length > 0 && (
  <section class="professional-photos" aria-labelledby="professional-photo-title">
    <div class="shell profile-photo-layout">
      <div class="profile-photo-copy"><p class="eyebrow">Professional practice</p><h2 id="professional-photo-title">The person <em>behind the pattern.</em></h2><p>Pattern development is careful, collaborative work—connecting technical decisions across the screen, sample room and finished garment.</p></div>
      <ImageGallery images={images} eager={true} interactive={false} />
    </div>
  </section>
)}
