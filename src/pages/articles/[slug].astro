---
import Base from '../../layouts/Base.astro'; import { articles } from '../../data/site';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
const bodies: Record<string, string[]> = {
'pattern-making-is-a-feedback-system': [`A development pattern is not a one-time drawing. It participates in a loop: an intended design becomes a sample, the sample produces evidence, and that evidence returns as a technical decision.`, `The quality of the loop depends on separating observation from interpretation. “The front looks wrong” is an observation with low precision. A useful record asks where, under what posture, against which specification, and after which construction process.`, `The pattern action must then remain linked to the result. A correction that was proposed is not yet a correction that worked. This distinction matters for both professional evidence and future AI systems.`, `My developing practice is to record five things: source, observation, reasoning, action and validation. That structure makes learning reusable while leaving room for uncertainty.`],
'building-an-evidence-safe-portfolio': [`Garment professionals face a portfolio problem: much of the strongest work belongs to an employer or buyer. Publishing the source file may breach trust; publishing nothing makes real capability difficult to see.`, `The answer is not to weaken confidentiality. It is to redesign the evidence. A public case study can describe the type of problem, the reasoning structure, the category of action and the lesson—without revealing a style number, specification, block, measurement or internal image.`, `Recreated diagrams should be generic. Outcomes should be phrased at the level the evidence supports. “Submitted for approval” is not “approved”; “assigned” is not “completed.”`, `This approach produces a smaller but more credible portfolio. Trust is part of technical competence.`],
'ai-garment-knowledge-taxonomy': [`A useful garment knowledge assistant needs more than a folder of comments. Retrieval depends on a shared structure that reflects how development work is actually recalled.`, `A practical record can include product category, design feature, buyer context, sample stage, issue type, evidence source, observed symptom, proposed action, validated result, confidence and confidentiality class.`, `The validation field is essential. Historical activity may be useful even when the result is unknown, but the system must not present a proposal as proven guidance.`, `The long-term opportunity is a human-in-the-loop tool: it retrieves relevant precedent, exposes the evidence trail and helps a technical professional reason faster. Final judgment remains with the responsible person.`]
};
---
<Base title={article.title} description={article.excerpt} type="article"><article class="article shell"><header><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lead">{article.excerpt}</p><div class="byline"><span>By Shorif Ahmmed</span><time datetime={article.date}>{new Date(article.date).toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'})}</time><span>{article.read} read</span></div></header><div class="article-body">{bodies[article.slug].map((p,i)=>i===0?<p class="first">{p}</p>:<p>{p}</p>)}<hr/><p class="note"><b>Practice note:</b> This article documents a working framework and learning direction. It does not disclose confidential buyer or employer material.</p><a class="text-link" href="/articles">← All articles</a></div></article></Base>
