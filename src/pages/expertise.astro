---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
const garmentPractice = ['Pattern development from tech packs, measurements and technical comments','Pattern modification and grading','Measurement-sheet preparation','Fit, PP and Size-Set sample support','Sample-pattern preparation and sample corrections','Production pattern support','Consumption marker preparation','Coordination with sample makers and QC teams'];
const digitalSkills = ['Gerber AccuMark / PDS','CLO 3D','Adobe Photoshop','Microsoft Word and Excel','Professional email, file handling and digital documentation','Windows, internet-based tools and AI-assisted digital workflows'];
const approvedSkills = [
  ['01','2D Pattern Making','Pattern development and correction from tech packs, measurements and technical comments.'],
  ['02','CLO 3D','Garment visualization and pattern-checking support within the development cycle.'],
  ['03','Grading','Sample, Size-Set and production-related pattern grading.'],
  ['04','Garment Construction','Construction-aware pattern decisions developed through sample work.'],
  ['05','Fit / Quality Analysis','Measurement, sample and technical-comment review to support corrections.'],
  ['06','Production Support','Production pattern adjustments, marker support and team coordination.'],
  ['07','Fabric / Material Understanding','Practical consideration of material behavior in garment and sample development.'],
  ['08','Technical Tools / Workflow','Gerber AccuMark, CLO 3D and clear digital documentation workflows.'],
];
---
<Base title="Expertise" description="CV-supported garment pattern, sample-development and digital capabilities of Shorif Ahmmed.">
  <section class="page-hero shell"><p class="eyebrow">Expertise</p><h1>Pattern development grounded in <em>technical requirements and sample work.</em></h1><p class="lead narrow">This page reflects the practical skills, tools and responsibilities documented in my CV.</p></section>
  <section class="shell section-space"><SectionHead eyebrow="Technical practice" title="Current professional capabilities." /><div class="capability-grid expertise-grid">{approvedSkills.map(item => <article><span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></article>)}</div><div class="skill-panel"><h3>Garment-development responsibilities</h3><ul class="check-list">{garmentPractice.map(item => <li>{item}</li>)}</ul></div></section>
  <section class="dark-section"><div class="shell section-space split"><SectionHead eyebrow="CLO 3D" title="Practical visualization and pattern-checking support." /><div class="prose"><p>I use CLO 3D for garment visualization, pattern checking and product-development support. It provides an additional digital view during development while physical sampling and technical review remain essential.</p><a class="button light-button" href="/projects/clo-3d-pattern-validation">View the CLO 3D work →</a></div></div></section>
  <section class="shell section-space split"><SectionHead eyebrow="Tools" title="Software and digital workflow." /><div class="skill-panel"><ul class="check-list">{digitalSkills.map(item => <li>{item}</li>)}</ul></div></section>
</Base>
