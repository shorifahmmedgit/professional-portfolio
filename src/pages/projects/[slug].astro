---
import Base from '../../layouts/Base.astro'; import { projects } from '../../data/site';
export function getStaticPaths(){ return projects.map(project => ({ params:{slug:project.slug}, props:{project} })); }
const { project } = Astro.props;
const details: Record<string, { problem: string; observation: string; action: string; result: string; lesson: string }> = {
  'comment-to-pattern-workflow': { problem:'Review comments can become disconnected actions when the observation, reasoning and result are not recorded together.', observation:'A useful workflow separates what was observed from what is assumed, then maps each approved comment to a defined pattern area.', action:'Create a traceable chain: source comment → interpretation → affected piece/point → proposed action → sample validation → reusable lesson.', result:'A clearer review loop, fewer ambiguous handoffs and a safer knowledge record that excludes proprietary measurements.', lesson:'The value is not a database of comments; it is a database of validated relationships.' },
  'overshirt-development-system': { problem:'An overshirt sits between shirt and outer layer, so silhouette, layering ease, fabric weight and construction interact strongly.', observation:'Treating any one measurement in isolation can shift balance or movement elsewhere in the garment.', action:'Review specification, intended layer, fabric behaviour, construction and pattern balance as a linked checklist before adjustment.', result:'A more disciplined development conversation and better questions before lines are changed.', lesson:'This is an evolving practice framework, not a claim of complete fit or fabric mastery.' },
  'clo-3d-pattern-validation': { problem:'A new style can look correct in 2D while the intended silhouette or proportion is still difficult to judge before a physical sample exists.', observation:'3D simulation can expose visual relationships between pattern shape, garment balance and the intended design early enough to support a better first decision.', action:'Prepare the draft pattern, simulate it on an avatar, compare the result with the tech pack or inspiration reference, review visible shape and proportion, refine the pattern where justified, then release it into the physical sample cycle.', result:'An additional pre-sample validation checkpoint that can improve confidence in the draft without treating virtual simulation as a substitute for fitting or physical sample approval.', lesson:'For me, CLO 3D is most useful when it supports pattern judgment. Buyer-facing visualization is secondary to the technical checking purpose.' },
  'garment-knowledge-retrieval': { problem:'Technical lessons often remain scattered across comments, images, personal memory and separate sample rounds.', observation:'Search becomes useful only when records share a consistent taxonomy and clearly distinguish proposed actions from validated outcomes.', action:'Index safe records by product, design feature, issue, sample stage, observation, action, result, confidence and confidentiality class.', result:'A concept for faster retrieval of relevant precedent while keeping a human pattern professional responsible for decisions.', lesson:'AI should improve recall and consistency; it should not convert uncertain history into false certainty.' },
};
const detail = details[project.slug]!;
---
<Base title={project.title} description={project.summary}><article class="case"><header class="case-hero shell"><p class="eyebrow">{project.eyebrow}</p><h1>{project.title}</h1><p class="lead narrow">{project.summary}</p><ul class="tag-row">{project.tags.map(t=><li>{t}</li>)}</ul></header><div class="case-diagram"><div class="shell flow"><span>Observe</span><i>→</i><span>Interpret</span><i>→</i><span>Act</span><i>→</i><span>Validate</span><i>→</i><span>Learn</span></div></div><div class="shell case-body"><aside><p>Disclosure</p><small>This is a reconstructed, public-safe study. It contains no proprietary buyer data or employer documents.</small></aside><div class="prose"><h2>Problem</h2><p>{detail.problem}</p><h2>Observation</h2><p>{detail.observation}</p><h2>Technical action</h2><p>{detail.action}</p><h2>Expected value</h2><p>{detail.result}</p><h2>Lesson</h2><p>{detail.lesson}</p><a class="button" href="/projects">Back to projects →</a></div></div></article></Base>
