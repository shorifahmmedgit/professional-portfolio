---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Connect with Shorif Ahmmed about garment pattern work, technical exchange, research or professional opportunities.">
<section class="page-hero shell contact-hero"><div><p class="eyebrow">Contact & networking</p><h1>Let’s discuss work that values <em>precision and growth.</em></h1><p class="lead">Open to relevant professional conversations about garment pattern making, technical development, knowledge systems and future opportunities.</p></div><div class="contact-card"><p class="eyebrow">Best channels</p><div class="contact-email"><button type="button" id="reveal-email" aria-controls="professional-email" aria-expanded="false">Professional Email <span>Reveal</span></button><div id="professional-email" hidden><p>shorif.ahmmed.a@gmail.com</p><div class="email-actions"><button type="button" id="copy-email">Copy Email</button><a href="mailto:shorif.ahmmed.a@gmail.com">Send Email <span>↗</span></a></div><small id="copy-status" aria-live="polite"></small></div></div><a href="https://www.linkedin.com/in/shorifahmmed" target="_blank" rel="me noopener noreferrer">LinkedIn <span>↗</span></a><a href="/cv">Public CV <span>↗</span></a><small>Please do not send proprietary buyer files, internal measurements or confidential factory information through an initial inquiry.</small></div></section>
<section class="shell section-space contact-types"><p class="eyebrow">Useful conversations</p><div class="capability-grid"><article><span>01</span><h3>Career opportunities</h3><p>Pattern, garment-technical and long-term buying-house roles aligned with demonstrated capability.</p></article><article><span>02</span><h3>Technical exchange</h3><p>Pattern workflow, grading, development learning and public-safe knowledge sharing.</p></article><article><span>03</span><h3>Research collaboration</h3><p>Responsible AI × garments, documentation and technical knowledge retrieval.</p></article><article><span>04</span><h3>Industry network</h3><p>Constructive professional relationships across Bangladesh’s apparel ecosystem.</p></article></div></section>
<script>
  const revealButton = document.querySelector('#reveal-email');
  const emailPanel = document.querySelector('#professional-email');
  revealButton?.addEventListener('click', () => { if (!(revealButton instanceof HTMLButtonElement) || !(emailPanel instanceof HTMLElement)) return; emailPanel.hidden = false; revealButton.setAttribute('aria-expanded', 'true'); revealButton.hidden = true; });
  const copyButton = document.querySelector('#copy-email');
  const copyStatus = document.querySelector('#copy-status');
  copyButton?.addEventListener('click', async () => { await navigator.clipboard.writeText('shorif.ahmmed.a@gmail.com'); if (copyStatus) copyStatus.textContent = 'Email copied.'; });
</script>
</Base>
