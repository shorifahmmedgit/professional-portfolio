---
import Base from '../layouts/Base.astro';
const work = [['⌁','2D Pattern Development','Gerber AccuMark'],['⬡','3D Garment Simulation','CLO 3D'],['♙','Garment Development','Sample to PP'],['▣','Technical Support','Fit, Grading, Techpack']];
---
<Base title="About" description="The professional story and current garment-development practice of Shorif Ahmmed.">
  <section class="compact-page shell about-option">
    <figure><img src="/media/profile/shorif-ahmmed-work-environment.webp" width="1122" height="1402" alt="Shorif Ahmmed in a professional pattern-development work environment" /></figure>
    <div class="about-option-copy"><p class="eyebrow">About me</p><h1>Shorif Ahmmed</h1><h2>Pattern Master | Garment Technologist<br/>3D Apparel Developer</h2><p>I am a Pattern Master with hands-on experience in pattern making, garment development, grading and 3D simulation. I work with buyer specifications, tech packs and real samples to deliver accurate and production-ready patterns.</p><dl><div><dt>● Current Position</dt><dd>Pattern Master, Interfab Shirt Manufacturing LTD.</dd></div><div><dt>● Experience</dt><dd>2022 – Present</dd></div><div><dt>● Specialization</dt><dd>2D Pattern (Gerber), CLO 3D, Garment Development</dd></div><div><dt>● Education</dt><dd>BBA in Finance & Banking</dd></div></dl></div>
  </section>
  <section class="shell option-what"><h2>What I Do</h2><div class="option-skill-row">{work.map(item => <article><span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></article>)}</div></section>
</Base>
