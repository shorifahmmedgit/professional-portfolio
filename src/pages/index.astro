---
import Base from '../layouts/Base.astro';
const capabilities = [
  { icon: '◇', short: '2D', title: 'Pattern Development' },
  { icon: '⬡', short: '3D', title: 'CLO 3D Simulation' },
  { icon: '♙', short: 'Garment', title: 'Development' },
  { icon: '♧', short: 'Sample & Production', title: 'Support' },
];
const featured = [
  { title: 'Coat Collar Short Sleeve', image: '/media/work/coat-collar-short-sleeve/physical-sample/sample-01.webp', href: '/projects', tags: ['CLO 3D','Physical Sample'] },
  { title: 'Pattern Correction Workflow', image: '/media/work/coat-collar-short-sleeve/clo-3d/clo3d-01.webp', href: '/projects/comment-to-pattern-workflow', tags: ['2D Pattern','Development'] },
  { title: 'CLO 3D Validation', image: '/media/work/coat-collar-short-sleeve/clo-3d/clo3d-03.webp', href: '/projects/clo-3d-pattern-validation', tags: ['CLO 3D','Fit Review'] },
];
---
<Base title="Shorif Ahmmed" description="Pattern Master in Dhaka working across Gerber 2D, CLO 3D, garment development and physical sample evaluation.">
  <section class="option-hero">
    <div class="option-hero-copy">
      <p class="option-kicker">Pattern Maker <i></i> Garment Technologist</p>
      <h1>Pattern Making<br/>Garment Technology<br/><em>3D Apparel Development</em></h1>
      <p>From concept to physical garment — combining 2D pattern, 3D simulation and real-world production experience.</p>
      <div class="actions"><a class="button" href="/projects">View My Work <span>→</span></a><a class="button button-secondary" href="/cv/shorif-ahmmed-resume.pdf" download>Download CV <span>↓</span></a></div>
    </div>
    <figure class="option-hero-photo"><img src="/media/profile/shorif-ahmmed-work-environment.webp" width="1122" height="1402" alt="Shorif Ahmmed in a professional pattern-development work environment" loading="eager" /></figure>
  </section>
  <section class="option-capabilities shell" aria-label="Core capabilities">{capabilities.map(item => <article><span>{item.icon}</span><div><b>{item.short}</b><small>{item.title}</small></div></article>)}</section>
  <section class="shell option-featured"><header><h2>Featured Work</h2><a href="/projects">View All →</a></header><div class="option-work-grid">{featured.map(item => <a href={item.href}><img src={item.image} alt={item.title} loading="lazy" /><h3>{item.title}</h3><div>{item.tags.map(tag => <span>{tag}</span>)}</div></a>)}</div></section>
</Base>
