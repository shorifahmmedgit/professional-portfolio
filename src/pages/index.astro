---
import Base from '../layouts/Base.astro';
import PatternVisual from '../components/PatternVisual.astro';
import SectionHead from '../components/SectionHead.astro';
import ProcessShowcase from '../components/ProcessShowcase.astro';
import { capabilities, projects, articles } from '../data/site';
---
<Base title="Shorif Ahmmed" description="Pattern Master in Dhaka working across both Gerber 2D and CLO 3D, combining digital pattern development, garment evaluation and physical sample learning across woven shirts and overshirts.">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="status"><i></i> Pattern Master · Dhaka, Bangladesh</p>
      <h1>Working across 2D and 3D to <em>develop patterns with a fuller garment view.</em></h1>
      <p class="lead">I work across both Gerber 2D and CLO 3D, combining the two as part of my pattern-development workflow. I use each environment to understand, refine and evaluate the garment from different angles—then connect those insights with physical sampling before final pattern release.</p>
      <div class="actions"><a class="button" href="/projects">Explore selected work <span>↗</span></a><a class="text-link" href="/about">My professional story <span>→</span></a></div>
      <dl class="hero-stats"><div><dt>Since 2022</dt><dd>Garment pattern practice</dd></div><div><dt>Gerber 2D</dt><dd>Drafting, correction & grading</dd></div><div><dt>CLO 3D</dt><dd>Fit, silhouette & look validation</dd></div><div><dt>Woven focus</dt><dd>Shirts & overshirts</dd></div></dl>
    </div>
    <PatternVisual />
  </section>

  <ProcessShowcase />

  <section class="statement dark-section">
    <p class="eyebrow light">Professional premise</p>
    <blockquote>“A strong pattern is not only a set of lines. It is a technical decision that connects design, construction, fabric and fit.”</blockquote>
    <p>This portfolio documents that decision-making honestly: what I can do now, what the evidence supports, and what I am deliberately learning next.</p>
  </section>

  <section class="shell section-space">
    <SectionHead eyebrow="Core practice" title="Technical work, grounded in the sample cycle." body="My strongest contribution is connecting specifications and comments to practical pattern action." />
    <div class="capability-grid">{capabilities.map((item) => <article><span>{item.n}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
  </section>

  <section class="shell section-space work-preview">
    <SectionHead eyebrow="Selected work" title="Public-safe studies in process and reasoning." body="No proprietary patterns, buyer documents or confidential measurements are shown." />
    <div class="project-grid">{projects.map((p, i) => <a class:list={['project-card', `tone-${i + 1}`]} href={`/projects/${p.slug}`}><span>{p.eyebrow}</span><h3>{p.title}</h3><p>{p.summary}</p><ul>{p.tags.map(t => <li>{t}</li>)}</ul><b>View study →</b></a>)}</div>
  </section>

  <section class="learning-band"><div class="shell learning-inner"><div><p class="eyebrow light">Development ledger</p><h2>Credibility includes the work still in progress.</h2></div><p>I am actively deepening fit diagnosis, fabric behaviour, construction logic, advanced grading, CLO 3D and technical communication. These are presented as learning areas—not inflated expertise.</p><a href="/expertise#learning">View the learning roadmap →</a></div></section>

  <section class="shell section-space">
    <SectionHead eyebrow="Field notes" title="Writing to make technical thinking reusable." />
    <div class="article-list">{articles.map((a) => <a href={`/articles/${a.slug}`}><div><span>{a.category} · {a.read}</span><h3>{a.title}</h3><p>{a.excerpt}</p></div><time datetime={a.date}>{new Date(a.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time><b>↗</b></a>)}</div>
    <a class="text-link end-link" href="/articles">Browse all writing <span>→</span></a>
  </section>
  <section class="cta-band"><p class="eyebrow light">Professional connection</p><h2>Interested in precise pattern work, technical learning or responsible garment innovation?</h2><a class="button light-button" href="/contact">Start a conversation ↗</a></section>
</Base>
