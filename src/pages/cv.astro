---
import Base from '../layouts/Base.astro';
import { experience } from '../data/site';
const cvPath = '/cv/shorif-ahmmed-resume.pdf';
---
<Base title="Professional CV" description="The professional CV of garment Pattern Master Shorif Ahmmed.">
<section class="page-hero shell">
  <p class="eyebrow">Professional CV</p><h1>Shorif Ahmmed</h1>
  <p class="lead narrow">Pattern Master with professional experience in pattern development, grading, sample development, fit and measurement.</p>
  <div class="actions no-print"><a class="button" href={cvPath} target="_blank" rel="noopener">View CV <span aria-hidden="true">↗</span></a><a class="text-link" href={cvPath} download="Shorif-Ahmmed-Resume.pdf">Download CV <span aria-hidden="true">↓</span></a></div>
</section>
<section class="shell cv-preview no-print" aria-labelledby="cv-preview-title"><div class="cv-preview-head"><div><p class="eyebrow">Original document</p><h2 id="cv-preview-title">CV preview</h2></div><a class="text-link" href={cvPath} target="_blank" rel="noopener">Open full screen <span>↗</span></a></div><object data={cvPath} type="application/pdf" aria-label="Shorif Ahmmed professional CV preview"><p>Your browser cannot display the PDF preview. <a href={cvPath}>View the original CV.</a></p></object></section>
<section class="shell cv-layout section-space">
  <aside>
    <h2>Profile</h2><p>Garment-industry technical professional with experience in pattern development, construction, sample development, fit and measurement.</p>
    <h2>Education</h2><p><b>BBA, Finance and Banking</b><br/>Government Azizul Haque College<br/>2019 · CGPA 3.17</p>
    <h2>Tools</h2><p>Gerber AccuMark / PDS<br/>CLO 3D<br/>Adobe Photoshop<br/>Microsoft Word and Excel<br/>Windows and internet-based tools</p>
    <h2>Languages</h2><p>Bangla · Native<br/>English · Written and spoken technical communication</p>
  </aside>
  <div>
    <h2>Experience</h2><div class="timeline light-timeline">{experience.map(item => <article><time>{item.period}</time><div><h3>{item.designation}</h3><p>{item.organization}</p></div></article>)}</div>
    <h2>Technical practice</h2><p>Pattern development · pattern modification · grading · measurement sheets · Fit, PP and Size-Set sample support · technical comment review · production pattern support · marker preparation · sample and QC coordination</p>
    <h2>Digital workflow</h2><p>Professional email communication, file handling, digital documentation and practical use of AI-enabled tools for documentation, information processing and repetitive-task efficiency.</p>
    <p class="note">Private contact, address, family and buyer information is intentionally excluded from this public page.</p>
  </div>
</section>
</Base>
