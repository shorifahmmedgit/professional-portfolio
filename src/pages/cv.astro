---
import Base from '../layouts/Base.astro'; import { timeline } from '../data/site';
---
<Base title="Professional CV" description="A concise, public-safe professional profile of garment pattern maker Shorif Ahmmed.">
<section class="page-hero shell">
  <p class="eyebrow">Professional CV</p>
  <h1>Shorif Ahmmed</h1>
  <p class="lead narrow">Pattern Master / Pattern Maker · Dhaka, Bangladesh</p>
  <div class="actions no-print">
    <button class="button" type="button" id="print-cv">Print / Save as PDF <span>↗</span></button>
    <a class="text-link" href="/expertise">View capability detail →</a>
  </div>
  <p class="print-only">Public professional profile · shorif-ahmmed.onrender.com</p>
</section>
<section class="shell cv-layout section-space">
  <aside>
    <h2>Profile</h2>
    <p>Self-taught garment pattern maker with practical Gerber 2D experience since 2022, focused on woven development, grading, sample correction and steady progression toward garment technology.</p>
    <h2>Education</h2>
    <p><b>BBA, Finance & Banking</b><br/>Government Azizul Haque College<br/>2019 · CGPA 3.17</p>
    <h2>Tools</h2>
    <p>Gerber AccuMark / PDS<br/>CLO 3D — developing, used for pattern validation<br/>Spreadsheets for measurement and structured evidence</p>
    <h2>Communication</h2>
    <p>Bangla — native<br/>English — working professional level for tech-pack reading, email handling and technical follow-up; speaking and terminology continue to develop.</p>
  </aside>
  <div>
    <h2>Experience</h2>
    <div class="timeline light-timeline">{timeline.map(x=><article><time>{x.period}</time><div><h3>{x.role}</h3><p>{x.org}</p><small>{x.note}</small></div></article>)}</div>
    <h2>Practice areas</h2>
    <p>Pattern development · Technical sketch and measurement-chart interpretation · Pattern modification · Grading · Digital/manual checking · Basic marker and solid consumption · Sample-cycle exposure · CLO 3D pre-sample validation · Buyer-facing email and technical follow-up</p>
    <h2>Current development direction</h2>
    <p>Fit diagnosis · fabric behaviour · construction logic · advanced grading · deeper CLO 3D · garment technology · AI-assisted garment workflow systems</p>
    <p class="note">This public CV intentionally excludes private personal information and confidential buyer/employer material. A detailed application CV can be shared directly when appropriate.</p>
  </div>
</section>
<script is:inline src="/print-cv.js"></script>
</Base>
